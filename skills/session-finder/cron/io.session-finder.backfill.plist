<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- session-finder 每 2 天增量索引。安装：
     cp 本文件到 ~/Library/LaunchAgents/ 后
     launchctl load -w ~/Library/LaunchAgents/io.session-finder.backfill.plist
     手动触发测试：launchctl start io.session-finder.backfill
     查看日志：tail -f ~/.claude/session-finder-cron.log -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.session-finder.backfill</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/luguotao/code/claude-station/skills/session-finder/cron/run-backfill.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/luguotao</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/Users/luguotao/.nvm/versions/node/v20.19.4/bin:/Library/Frameworks/Python.framework/Versions/3.13/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- 每 2 天 = 172800 秒。睡眠期间错过则唤醒后补跑一次。 -->
  <key>StartInterval</key>
  <integer>172800</integer>

  <!-- 加载/开机时不立即跑，只按 StartInterval。 -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/luguotao/.claude/session-finder-cron.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/luguotao/.claude/session-finder-cron.err</string>
</dict>
</plist>
